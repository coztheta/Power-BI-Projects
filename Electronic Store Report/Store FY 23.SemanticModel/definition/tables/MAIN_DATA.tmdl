	column 'Avg Basket Size' =
			
			DIVIDE(
				SUM('MAIN_DATA'[Invoice Quantity]),
				DISTINCTCOUNT('MAIN_DATA'[TXNName])
			)
		formatString: 0.0
		lineageTag: b6a91087-b7d1-4a25-9aba-99e84a363551
		summarizeBy: sum

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

	column Profitability =
			
			DIVIDE(SUM('MAIN_DATA'[GP Amount]), SUM('MAIN_DATA'[Taxable Amount]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3704121b-f9b1-49f7-b0c8-10187821ff51
		summarizeBy: sum

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

	column Profit =
			
