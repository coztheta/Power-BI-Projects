table Sales
	lineageTag: f0fbd226-7569-4443-92f2-88c819615651

	measure 'Total Revenue' = SUM(Sales[Revenue])
		lineageTag: 5b191da3-3d40-41d9-b606-9c1b84aa87c7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pre Qtr Rev.' = CALCULATE([Total Revenue],PREVIOUSQUARTER('Date Master'[Date]))
		lineageTag: d3b921ff-e4d2-4f70-8735-60b81d9fc1b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'QoQ Growth' = ([Total Revenue]-[Pre Qtr Rev.])/[Pre Qtr Rev.]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ef1d4088-3de7-4f0d-9ff9-ec85e3eae45f

		changedProperty = FormatString

