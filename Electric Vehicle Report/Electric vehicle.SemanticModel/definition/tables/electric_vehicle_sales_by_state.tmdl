	column Total_Price_vehicle_state =
			
			SWITCH(
			    TRUE(),
			    electric_vehicle_sales_by_state[vehicle_category]="2-Wheelers",electric_vehicle_sales_by_state[total_vehicles_sold]*85000,
			    electric_vehicle_sales_by_state[vehicle_category] = "4-Wheelers" , electric_vehicle_sales_by_state[total_vehicles_sold]*1500000,
			    BLANK()
			)
		formatString: 0
