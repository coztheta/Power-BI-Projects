	column Total_Price_EV_state = ```
			
			                    SWITCH(
			                        TRUE(),
			                        electric_vehicle_sales_by_state[vehicle_category] = "2-Wheelers" , electric_vehicle_sales_by_state[electric_vehicles_sold]*85000,
			                        electric_vehicle_sales_by_state[vehicle_category] = "4-Wheelers" , electric_vehicle_sales_by_state[electric_vehicles_sold]*1500000,
